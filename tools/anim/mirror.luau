--!nocheck
-- Mirror a clip left ↔ right (Lune 0.10+):  lune run tools/anim/mirror.luau <Source> <Target>
-- Reads tools/anim/<Source>.luau, swaps every right / left channel pair, negates the sideways channels (roll, yaw,
-- side, headYaw) and writes tools/anim/<Target>.luau as a plain clip table (generated: edit the source, re-run).

local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")

local dir = "tools/anim/"
local src = process.args[1] or error("usage: lune run tools/anim/mirror.luau <Source> <Target>")
local dst = process.args[2] or error("usage: lune run tools/anim/mirror.luau <Source> <Target>")
local clip = luau.load(fs.readFile(dir .. src .. ".luau"), { debugName = src })()

local PAIRS = {
	{ "rArm", "lArm" },
	{ "rLeg", "lLeg" },
	{ "rArmOut", "lArmOut" },
	{ "rLegOut", "lLegOut" },
	{ "rArmTwist", "lArmTwist" },
	{ "rLegTwist", "lLegTwist" },
	{ "rPlant", "lPlant" },
}
local NEGATE = { roll = true, yaw = true, side = true, headYaw = true }

local function mirrorKey(k: { [string]: any }): { [string]: any }
	local m = table.clone(k)
	for _, pair in ipairs(PAIRS) do
		m[pair[1]], m[pair[2]] = k[pair[2]], k[pair[1]]
	end
	for ch in pairs(NEGATE) do
		if type(k[ch]) == "number" then
			m[ch] = -k[ch]
		end
	end
	return m
end
local function mirrorMap(t: { [string]: any }?): { [string]: any }?
	if not t then
		return nil
	end
	local m = {}
	for ch, v in pairs(t) do
		local other = ch
		for _, pair in ipairs(PAIRS) do
			if ch == pair[1] then
				other = pair[2]
			elseif ch == pair[2] then
				other = pair[1]
			end
		end
		m[other] = v
	end
	return m
end

-- Plain Luau source for a value (numbers rounded to 4 places, keys sorted, `t` first).
local function num(v: number): string
	local s = string.format("%.4f", v):gsub("0+$", ""):gsub("%.$", "")
	return s
end
local function emit(v: any, indent: string): string
	if type(v) == "number" then
		return num(v)
	elseif type(v) == "string" then
		return string.format("%q", v)
	elseif type(v) == "boolean" then
		return tostring(v)
	elseif type(v) == "table" then
		local inner = indent .. "\t"
		local parts = {}
		if #v > 0 then
			for _, x in ipairs(v) do
				table.insert(parts, inner .. emit(x, inner) .. ",")
			end
		else
			local keys = {}
			for k in pairs(v) do
				table.insert(keys, k)
			end
			table.sort(keys, function(a, b)
				if a == "t" then
					return true
				elseif b == "t" then
					return false
				end
				return a < b
			end)
			for _, k in ipairs(keys) do
				table.insert(parts, inner .. k .. " = " .. emit(v[k], inner) .. ",")
			end
		end
		return "{\n" .. table.concat(parts, "\n") .. "\n" .. indent .. "}"
	end
	error("can't emit " .. typeof(v))
end

local out = table.clone(clip)
out.name = dst
out.keys = {}
for i, k in ipairs(clip.keys) do
	out.keys[i] = mirrorKey(k)
end
out.springs = mirrorMap(clip.springs)
out.lag = mirrorMap(clip.lag)
out.noise = mirrorMap(clip.noise)
out.noSpring = mirrorMap(clip.noSpring)
-- Per-channel tracks: swap the sides, negate the sideways channels' values.
if clip.tracks then
	out.tracks = {}
	for ch, points in pairs(mirrorMap(clip.tracks) :: { [string]: any }) do
		local copy = {}
		for i, pt in ipairs(points) do
			copy[i] = table.clone(pt)
			if NEGATE[ch] then
				copy[i][2] = -pt[2]
			end
		end
		out.tracks[ch] = copy
	end
end

local header = ("--!strict\n-- %s: GENERATED by tools/anim/mirror.luau from %s.luau (left ↔ right). Edit the source and re-run:\n"):format(
	dst,
	src
) .. ("--   lune run tools/anim/mirror.luau %s %s\n\nreturn "):format(src, dst)
fs.writeFile(dir .. dst .. ".luau", header .. emit(out, "") .. "\n")
print(("wrote %s%s.luau (%d keys)"):format(dir, dst, #out.keys))
