# Wally packages (restored with `wally install`)
/Packages
/ServerPackages
/DevPackages
wally.lock

# Rojo / luau-lsp generated
sourcemap.json
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
!assets/**/*.rbxm
!assets/**/*.rbxmx

# Selene generated std
roblox.yml

# OS / editor
.DS_Store
Thumbs.db
*.lock.rbxl

# Local art toolchain and render intermediates
art3d/.venv/
art3d/.tools/
art3d/**/__pycache__/
art3d/out/**/frames/
art3d/out/logs/
art3d/*.zip
*.blend1

# Design-doc build intermediates (rebuild with docs/design/build/build.ps1)
docs/design/build/*.html
!docs/design/build/template.html

# Lune analysis output (tools/anim/analyse.luau)
tools/anim/out/

# Marketing images (thumbnails, icon): large PNGs kept on the owner's PC, not in git
marketing/
__pycache__/

# Art build outputs: .blend files and the sheet's HTML are rebuilt by art/*/build.py + art/tools/sheet.py
art/out/**/*.blend
art/out/**/*.blend1
art/out/**/contact_sheet.html
art/out/Review/

# Bomb skin maps (107 MB): rebuilt by art/bomb/skins.py; the uploaded ids live in src/shared/Assets.luau (Assets.Skins)
art/out/Skins/**/*_COLOR.png
art/out/Skins/**/*_NORMAL.png
art/out/Skins/**/*_ROUGHNESS.png
art/out/Skins/**/*_METAL.png

# Baked model maps (rebuilt by art/<asset>/build.py; uploaded ids live in each export/textures/ids.json)
art/out/Crate.*/export/textures/*.png
# Frames pulled from the owner's reference video (the video stays on the owner's PC)
art/ref/video/
art/out/Prop.*/export/textures/*.png
art/out/Prop.*/export/textures_*/*.png
art/ref/gems/
art/ref/quarry/
art/ref/video2/

# Licensed SFX pack: the source files and the mastered wavs stay on the owner's PC (licensed, not ours to redistribute);
# art/audio/master_licensed.py rebuilds the masters, art/out/Audio/Licensed/ids.json keeps the uploaded ids
art/audio/in/
art/out/Audio/Licensed/*.wav
